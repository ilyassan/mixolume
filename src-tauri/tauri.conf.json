{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiXolume",
  "version": "0.1.0-beta.2",
  "identifier": "com.mixolume.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MiXolume",
        "width": 360,
        "height": 480,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "Mixolume Dev"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NjE2QkFCOUM4NjYzMQpSV1F4WnNpNXVoWldCVkF0dFdRZVRHb2pNWTFuV0xWOGtGc0RNMm9pcytFYkxjWlNsRHE0M0xkbgo=",
      "endpoints": [
        "https://github.com/ilyassan/mixolume/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
